<Project>

	<!-- Directory.Build.targets
	
	See Readme.md for prerequisites and full details.
	
	
	-->

	<!-- AssemblySearchPaths and AcReferencePath are assigned
	multiple times, once for each build cycle that targets a 
	different framework version. 
	
	This ensures that MSBUILD uses the correct AutoCAD reference 
	assemblies for each target framework.
	
	Because MSBUILD searches for reference assemblies in the paths 
	specified in the <AssemblySearchPaths> property before it falls 
	back to using the <HintPath> element specified for a reference, 
	we can leverage this to allow framework-specific references to 
	AutoCAD reference assemblies to be specified in the .csproj file, 
	without	having to specify explicit locations in <HintPath> elements
	for each reference.	-->

	<PropertyGroup Condition="Exists('$(AcReferencePath)')">
		<AssemblySearchPaths>$(AcReferencePath);$(AssemblySearchPaths)</AssemblySearchPaths>
	</PropertyGroup>

	<!-- 
	========================================================= 
	Predefined references for basic AutoCAD assemblies to be
	used by all projects that use this file. 
	
	You can add additional references here, keeping in mind 
	that they will be added to all projects that use this file.
	
	To accomodate extensions that are intended to not have a
	dependence on AutoCAD (e.g., loaded into AcCoreConsole.exe,
	or another RealDwg host application), You can set the
	<RealDwg> property to true in your .csproj file. 
	If you do that, AcMgd.dll is not referenced.
	
	========================================================= 
	-->
	<PropertyGroup>
		<RealDwg Condition="'$(ExecutableName)' == 'accoreconsole.exe'">true</RealDwg>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="acmgd" Condition="'$(RealDwg)' != 'true'">
			<Private>false</Private>
			<SpecificVersion>false</SpecificVersion>
		</Reference>
		<Reference Include="acdbmgd">
			<SpecificVersion>false</SpecificVersion>
			<Private>false</Private>
		</Reference>
		<Reference Include="accoremgd">
			<SpecificVersion>false</SpecificVersion>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<!-- ========================================================= 
	Global usings and aliases 
	
	
	Lines with the Alias= attribute only define an alias that
	is usually only used to disambiguate a type (for example,
	AcRx.Exception verses System.Exception).
	
	Lines without the Alias= attribute define a global using.
	
	-->
	<ItemGroup>
		<Using Include="Autodesk.AutoCAD.ApplicationServices" />
		<Using Include="Autodesk.AutoCAD.ApplicationServices" Alias="AcAp"/>
		<Using Include="Autodesk.AutoCAD.EditorInput"/>
		<Using Include="Autodesk.AutoCAD.EditorInput" Alias="AcEd"/>
		<Using Include="Autodesk.AutoCAD.DatabaseServices"/>
		<Using Include="Autodesk.AutoCAD.DatabaseServices" Alias="AcDb" />
		<Using Include="Autodesk.AutoCAD.Runtime"/>
		<Using Include="Autodesk.AutoCAD.Runtime" Alias="AcRx" />
		<Using Include="Autodesk.AutoCAD.Geometry"/>
		<Using Include="Autodesk.AutoCAD.Geometry" Alias="AcGe" />
		<Using Include="Autodesk.AutoCAD.GraphicsInterface"/>
		<Using Include="Autodesk.AutoCAD.GraphicsInterface" Alias="AcGi" />
		<Using Include="Autodesk.AutoCAD.Internal"/>
		<!-- Use only if required as it requires too much
		     disabiguation between same-named types in other
			 namespaces.
		<Using Include="Autodesk.AutoCAD.GraphicsSystem"/>
		<Using Include="Autodesk.AutoCAD.GraphicsSystem" Alias="AcGs" />
		-->
		<Using Include="System.Math" Static="true" />
	</ItemGroup>

	<!-- Conditional alias for the Application or Core.Application 
	class depending on if AcMgd.dll is referenced:
	When acmgd.dll is not referenced (e.g., $(RealDwg) == true), assign the
	AcadApp alias to Autodesk.AutoCAD.ApplicationServices.Core.Application.
	Otherwise, assign it to Autodesk.AutoCAD.ApplicationServices.Application
	-->
	<ItemGroup>
		<Using Include="Autodesk.AutoCAD.ApplicationServices.Core" Condition="'$(RealDwg)' == 'true'"/>
		<Using Include="Autodesk.AutoCAD.ApplicationServices.Core.Application" Alias="AcadApp" Condition="'$(RealDwg)' == 'true'" />
		<Using Include="Autodesk.AutoCAD.ApplicationServices.Application" Alias="AcadApp" Condition="'$(RealDwg)' != 'true'" />
		<Using Include="Autodesk.AutoCAD.ApplicationServices" Condition="'$(RealDwg)' != 'true'" />
	</ItemGroup>

	<!-- ====================================================================== -->
	<!-- Support for startup .dwg, .dwt, .scr files, and command line arguments -->
	<!-- ====================================================================== -->	    

	<PropertyGroup Condition="'$(TargetFramework)' != ''">
		<StartupPath Condition="'$(StartupPath)' == ''">$(MSBuildProjectDirectory)\$(StartupFolder)\</StartupPath>
		<StartupPath Condition="!$([System.IO.Path]::IsPathRooted('$(StartupPath)'))">$(MSBuildProjectDirectory)\$(StartupPath)</StartupPath>
		<StartupPath Condition="!HasTrailingSlash('$(StartupPath)')">$(StartupPath)\</StartupPath>

		<_LoaderScript>$(TargetDir)$(AssemblyName).scr</_LoaderScript>

		<!-- Clear out these properties on each build cycle -->
		<DebugScriptPath></DebugScriptPath>
		<_DwgPath></_DwgPath>
		<_ScriptPath></_ScriptPath>
		<_CommandLine></_CommandLine>
	</PropertyGroup>
	

	<!-- Resolve Startup DWG File -->
	<Choose>
		<!-- Check if user explicitly-specified a startup drawing file -->
		<When Condition="Exists('$(StartupDrawing)')">
			<PropertyGroup>
				<_DwgPath>$(StartupDrawing)</_DwgPath>
			</PropertyGroup>
		</When>
		<Otherwise> <!-- Look for a .dwg file in the Startup Assets folder -->
			<PropertyGroup Condition="Exists('$(StartupPath)')">
				<_DwgFiles>$([System.IO.Directory]::GetFiles('$(StartupPath)', '*.dwg'))</_DwgFiles>
				<_DwgPath Condition="'$(_DwgFiles)' != ''">$(_DwgFiles.Split(';')[0])</_DwgPath>
			</PropertyGroup>
		</Otherwise>
	</Choose>

	<!-- Resolve startup drawing template file -->
	<Choose>
		<When Condition="'$(_DwgPath)' == '' And Exists('$(StartupTemplate)')">
			<PropertyGroup>
				<_DwtPath>$(StartupTemplate)</_DwtPath>
			</PropertyGroup>
		</When>
		<Otherwise>
			<PropertyGroup Condition="Exists('$(StartupPath)')">
				<_DwtFiles>$([System.IO.Directory]::GetFiles('$(StartupPath)', '*.dwt'))</_DwtFiles>
				<_DwtPath Condition="'$(_DwtFiles)' != ''">$(_DwtFiles.Split(';')[0])</_DwtPath>
			</PropertyGroup>
		</Otherwise>
	</Choose>

	<!-- Resolve Startup Script File -->
	<Choose>
		<When Condition="Exists('$(StartupScript)')">
			<PropertyGroup>
				<_ScriptPath>$(StartupScript)</_ScriptPath>
			</PropertyGroup>
		</When>
		<Otherwise>
			<PropertyGroup Condition="Exists('$(StartupPath)')">
				<_ScrFiles>$([System.IO.Directory]::GetFiles('$(StartupPath)', '*.scr'))</_ScrFiles>
				<_ScriptPath Condition="'$(_ScrFiles)' != ''">$(_ScrFiles.Split(';')[0])</_ScriptPath>
			</PropertyGroup>
		</Otherwise>
	</Choose>

	<!-- Resolve Effective Command Line -->
	<Choose>
		<When Condition="'$(TargetFramework)' != ''">
			<Choose>
				<!-- A User-specified command line overrides all default processing -->
				<When Condition="'$(CommandLineArgs.Trim())' != ''">
					<PropertyGroup>
						<_CommandLine>$(CommandLineArgs)</_CommandLine>
					</PropertyGroup>
				</When>
				<!-- Construct the default command line using contents of Startup folder and loader script file -->
				<Otherwise>
					<Choose>
						<!-- Check for a .dwg file -->
						<When Condition="Exists('$(_DwgPath)')">
							<PropertyGroup>
								<_CommandLine>"$(_DwgPath)" </_CommandLine>
							</PropertyGroup>
						</When>
						<Otherwise>
							<!-- Check for a .dwt template file-->
							<PropertyGroup Condition="Exists('$(_DwtPath)')">
								<_CommandLine>/t "$(_DwtPath)" </_CommandLine>
							</PropertyGroup>
						</Otherwise>
					</Choose>

					<!-- Point /b switch to the target-framework-specific loader.scr generated in $(TargetDir) -->
					<PropertyGroup>
						<_LoaderScript>$(TargetDir)$(AssemblyName).scr</_LoaderScript>
						<_CommandLine>$(_CommandLine) /b "$(_LoaderScript)" </_CommandLine>
					</PropertyGroup>

					<!-- Append /nologo switch and any additional arguments in <AppendToCommandLine> -->
					<PropertyGroup>
						<_CommandLine>$(_CommandLine.Trim()) /nologo $(AppendToCommandLine.Trim())</_CommandLine>
					</PropertyGroup>
				</Otherwise>
			</Choose>
		</When>
	</Choose>

	<!-- Store resolved command line in CommandLineArgs for use by launchSettings.json -->
	<PropertyGroup Condition="'$(_CommandLine.Trim())' != ''">
		<CommandLineArgs>$(_CommandLine.Trim())</CommandLineArgs>
	</PropertyGroup>

	<!-- ====================================================================== -->
	<!-- Framework-Specific Loader Script Generation                            -->
	<!-- ====================================================================== -->

	<Target Name="GenerateLoaderScript" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
		<PropertyGroup>
			<_Target>$(TargetPath.Replace('\', '\\'))</_Target>
			<_Script Condition="'$(_ScriptPath)' != ''">$(_ScriptPath.Replace('\', '\\'))</_Script>
			<_ScriptContent>((lambda (dll scr / f) (if (setq f (findfile dll))(command "._NETLOAD" dll))(if (setq f (findfile scr))(command "._SCRIPT" scr))(princ)) "$(_Target)" "$(_Script)")</_ScriptContent>
			<_ScriptOutput>$(TargetDir)$(AssemblyName).scr</_ScriptOutput>
		</PropertyGroup>
		<WriteLinesToFile File="$(_ScriptOutput)" Lines="$(_ScriptContent)" Overwrite="true" WriteOnlyWhenDifferent="true" />
		<Message Text="[$(MSBuildProjectName) ($(TargetFramework))]: Generated loader script at: $(_ScriptOutput)" Importance="high" />
	</Target>

	<!-- IMPORTANT: Required to trigger evaluation of $(CommandLineArgs) -->
	<Target Name="EvaluateCommandLineArgs" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
		<Message Text="[$(MSBuildProjectName) ($(TargetFramework))]: Command Line: $(CommandLineArgs)" Importance="high" />
	</Target>	
	
	
	<!-- ==================================================== -->
	<!-- Diagnostic / Informational output -->
	<!-- ==================================================== -->

	<!-- Formatting macros -->
	<PropertyGroup>
		<!-- AutoCAD / Framework version -->
		<TargetDisplayName>AutoCAD $(AcMinVer) / .NET $(TargetFrameworkVersion)</TargetDisplayName>
		<!-- Project name and target framework -->
		<ProjectDisplayName>$(MSBuildProjectName) ($(TargetFramework))</ProjectDisplayName>
	</PropertyGroup>

	<!-- Post-build: display the build target display 
	name and the path to the AutoCAD reference assemblies 
	that were used used for the build target.-->

	<Target Name="ReportReferences" AfterTargets="Build">
		<Message Text="[$(ProjectDisplayName)]: Built target for $(TargetDisplayName) using references from $(AcReferencePath)"
			Condition="'$(AcReferencePath)' != ''"
			Importance="high">
		</Message>
	</Target>

	<!-- Displays the command line arguments for debug/diagnostics purposes 
	To enable, use <Debug_CommandLineArgs>true</Debug_CommandLineArgs>
	in a PropertyGroup within the .csproj file.
	-->

	<Target Name="DebugCommandLineTarget" AfterTargets="Build" Condition="'$(DebugCommandLine)' == 'true' And '$(TargetFramework)' != ''">
		<PropertyGroup>
			<!-- Helper formatting to show [Empty] instead of blank strings in build output -->
			<_DwgPathDisplay Condition="'$(_DwgPath)' != ''">$(_DwgPath)</_DwgPathDisplay>
			<_DwgPathDisplay Condition="'$(_DwgPath)' == ''">[Empty]</_DwgPathDisplay>

			<_ScriptPathDisplay Condition="'$(_ScriptPath)' != ''">$(_ScriptPath)</_ScriptPathDisplay>
			<_ScriptPathDisplay Condition="'$(_ScriptPath)' == ''">[Empty]</_ScriptPathDisplay>

			<_CommandLineDisplay Condition="'$(_CommandLine)' != ''">$(_CommandLine)</_CommandLineDisplay>
			<_CommandLineDisplay Condition="'$(_CommandLine)' == ''">[Empty]</_CommandLineDisplay>
		</PropertyGroup>

		<Message Text="[$(ProjectDisplayName) DEBUG]: StartupPath:     $(StartupPath)" Importance="high" />
		<Message Text="[$(ProjectDisplayName) DEBUG]: _DwgPath:        $(_DwgPathDisplay)" Importance="high" />
		<Message Text="[$(ProjectDisplayName) DEBUG]: _ScriptPath:     $(_ScriptPathDisplay)" Importance="high" />
		<Message Text="[$(ProjectDisplayName) DEBUG]: _CommandLine:    $(_CommandLineDisplay)" Importance="high" />
		<Message Text="[$(ProjectDisplayName) DEBUG]: CommandLineArgs: $(CommandLineArgs)" Importance="high" />
	</Target>
	
	<!-- Verify that required environment variables are defined for 
		 each targeted framework being used in the project, and point 
		 to a valid path that holds AutoCAD reference assemblies:
	-->

	<Target Name="ValidateAcReferencePath" BeforeTargets="PrepareForBuild">
		<Error Condition="'$(_Ver)' == '4' And ('$(AC_NET_4_REF_PATH)' == '' Or !Exists('$(AC_NET_4_REF_PATH)\accoremgd.dll'))"
			Text="[$(ProjectDisplayName)]: The 'AC_NET_4_REF_PATH' environment variable is not defined or the specified path does not contain reference assemblies for $(TargetDisplayName). Value: '$(AC_NET_4_REF_PATH)'."/>

		<Error Condition="'$(_Ver)' == '8' And ('$(AC_NET_8_REF_PATH)' == '' Or !Exists('$(AC_NET_8_REF_PATH)\accoremgd.dll'))"
			Text="[$(ProjectDisplayName)]: The 'AC_NET_8_REF_PATH' environment variable is not defined or does not contain reference assemblies for $(TargetDisplayName). Value: '$(AC_NET_8_REF_PATH)'."/>

		<Error Condition="'$(_Ver)' == '10' And ('$(AC_NET_10_REF_PATH)' == '' Or !Exists('$(AC_NET_10_REF_PATH)\accoremgd.dll'))"
			Text="[$(ProjectDisplayName)]: The 'AC_NET_10_REF_PATH' environment variable is not defined or does not contain reference assemblies for $(TargetDisplayName)'. Value: '$(AC_NET_10_REF_PATH)'."/>
	</Target>

	<!-- Displays the assembly search path for debug/diagnostics purposes 
	To enable, use <DebugAssemblySearchPaths>true</DebugAssemblySearchPaths>
	in a PropertyGroup within a .csproj file.
	-->

	<Target Name="DebugAssemblySearchPaths"
			Condition="'$(DebugAssemblySearchPaths)' == 'true'"
			BeforeTargets="ResolveAssemblyReferences">
		<Message Text="[$(ProjectDisplayName)]: AssemblySearchPaths: $(AssemblySearchPaths)" Importance="high" />
	</Target>

	<!-- Displays the path that Visual Studio expects to find 
	AutoCAD reference assemblies in. For debug/diagnostics purposes.
	To enable, use <DebugAcadReferencePath>true</DebugAcadReferencePath>
	in a PropertyGroup within .csproj file. Note that this path will also 
	appear in the list of assembly search paths displayed by the above target.
	-->

	<Target Name ="DebugAcadReferencePath"
			Condition="'$(DebugAcadReferencePath)' == 'true' And '$(TargetFramework)' != ''"
			BeforeTargets="ResolveAssemblyReferences">
		<Message Text="[$(ProjectDisplayName)]: AutoCAD Reference Path: $(AcReferencePath)" Importance="high" />
	</Target>


</Project>
